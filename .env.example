# Скопируйте в .env:  cp .env.example .env

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Суперюзер создаётся автоматически при старте web
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin

# PostgreSQL (эти же переменные читает контейнер db)
POSTGRES_DB=reminders
POSTGRES_USER=reminders
POSTGRES_PASSWORD=reminders
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Celery
CELERY_BROKER_URL=redis://redis:6379/0

# От кого уходят письма
DEFAULT_FROM_EMAIL=reminders@example.com
